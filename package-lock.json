{
  "name": "pipeline",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pipeline",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@pipeline/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@pipeline/operators-base": {
      "resolved": "packages/operators-base",
      "link": true
    },
    "node_modules/@pipeline/test": {
      "resolved": "packages/test",
      "link": true
    },
    "packages/core": {
      "name": "@pipeline/core",
      "version": "1.0.1",
      "license": "ISC"
    },
    "packages/operators-base": {
      "name": "@pipeline/operators-base",
      "version": "1.0.0",
      "license": "ISC",
      "dependencies": {
        "@pipeline/core": "~1.0.1"
      }
    },
    "packages/test": {
      "name": "@pipeline/test",
      "version": "1.0.0",
      "license": "ISC",
      "dependencies": {
        "@pipeline/core": "~1.0.1",
        "@pipeline/operators-base": "1.0.0"
      }
    }
  }
}
